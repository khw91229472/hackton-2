rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 인증 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 사용자 정보 및 권한 조회
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 관리자 여부 확인 (role === 'admin')
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // 교사 여부 확인 (role === 'teacher')
    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    // 1. users 컬렉션 권한 규칙
    // - 인증된 사용자는 본인 계정 정보 조회 및 최초 프로필 생성 가능
    // - 관리자는 전체 사용자 프로필 조회 및 권한 관리 가능
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. equipments 컬렉션 (K-에듀파인 기자재 원본 대장) 권한 규칙
    // - 원본 기자재 생성(create), 엑셀 일괄 등록, 삭제(delete)는 관리자만 가능
    // - 일반 교사는 조회(read) 및 현장 실사 필드만 제한적으로 수정(update) 가능
    match /equipments/{equipmentId} {
      allow read: if isAuthenticated();

      // 원본 기자재 생성 및 삭제: 관리자 전용
      allow create, delete: if isAdmin();

      // 수정: 관리자는 모든 필드 수정 가능, 교사는 실사 대조 필드만 수정 가능
      allow update: if isAdmin() || (
        isTeacher() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['actualQuantity', 'status', 'notes', 'lastCheckedAt', 'checkedBy'])
      );
    }

    // 3. inspections 컬렉션 (실사 이력 로그)
    match /inspections/{inspectionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
