rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // [공통 보안 헬퍼 함수 (Security Helper Functions)]
    // ============================================================================

    // 1. 인증 여부 확인: 로그인하지 않은 사용자는 Firestore 데이터를 일체 읽거나 쓸 수 없음
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. 현재 로그인한 사용자의 Firestore 프로필 문서 조회 (users/{uid})
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 3. 사용자 소속 학교 식별자(schoolId) 조회 (학교 간 데이터 격리)
    function getUserSchoolId() {
      return getUserData().schoolId;
    }

    // 4. 관리자 권한 여부 확인 (role === 'admin')
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // 5. 일반 교사 권한 여부 확인 (role === 'teacher')
    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    // 6. 학교별 데이터 격리 검증: 사용자의 소속 학교와 대상 문서의 schoolId가 일치하는지 확인
    function isSameSchool(targetSchoolId) {
      return isAuthenticated() && targetSchoolId == getUserSchoolId();
    }

    // ============================================================================
    // 1. users 컬렉션 규칙
    // - 원칙 1: 사용자는 자신의 사용자 정보만 읽을 수 있다.
    // - 원칙 2: admin은 소속 학교 사용자 정보를 관리(조회, 수정, 삭제)할 수 있다.
    // ============================================================================
    match /users/{userId} {
      // 조회: 본인 계정 정보이거나 동일 학교 관리자만 읽기 가능
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isAdmin() && isSameSchool(resource.data.schoolId))
      );

      // 생성: 인증된 사용자가 본인의 uid로 프로필을 최초 등록할 때 허용
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // 수정: 본인은 개인 프로필(이름, 학과 등) 수정 가능 (단, role 임의 승격 방지), 관리자는 모든 필드 수정 가능
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        (isAdmin() && isSameSchool(resource.data.schoolId))
      );

      // 삭제: 오직 소속 학교의 관리자만 계정 삭제 가능
      allow delete: if isAdmin() && isSameSchool(resource.data.schoolId);
    }

    // ============================================================================
    // 2. equipment 컬렉션 (K-에듀파인 기자재 원본 대장) 규칙
    // - 원칙 1: 로그인한 교사 및 관리자는 소속 학교의 기자재 원본 대장 읽기 가능
    // - 원칙 2: admin만 기자재 생성, 수정, 삭제 가능 (대장 엑셀 일괄 등록 및 편집)
    // - 원칙 3: 교사의 현장 실사 입력으로 원본 데이터를 절대 직접 수정하지 않는다.
    // ============================================================================
    match /equipment/{equipmentId} {
      // 읽기: 동일 학교 소속의 인증된 교사 또는 관리자에게 허용
      allow read: if (isTeacher() || isAdmin()) && isSameSchool(resource.data.schoolId);

      // 생성/수정/삭제: 오직 동일 학교 소속의 관리자(admin)만 가능 (교사는 쓰기 불가)
      allow create: if isAdmin() && isSameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && isSameSchool(resource.data.schoolId) && isSameSchool(request.resource.data.schoolId);
      allow delete: if isAdmin() && isSameSchool(resource.data.schoolId);
    }

    // 복수형 컬렉션명(equipments) 호환성 유지
    match /equipments/{equipmentId} {
      allow read: if (isTeacher() || isAdmin()) && isSameSchool(resource.data.schoolId);
      allow create: if isAdmin() && isSameSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && isSameSchool(resource.data.schoolId) && isSameSchool(request.resource.data.schoolId);
      allow delete: if isAdmin() && isSameSchool(resource.data.schoolId);
    }

    // ============================================================================
    // 3. inspections 컬렉션 (현장 실사 결과 로그) 규칙
    // - 원칙 1: 로그인한 교사는 본인 소속 학교의 실사 결과 생성 가능
    // - 원칙 2: 교사는 본인이 작성한 실사 결과만 조회 가능 (inspectorId == auth.uid)
    // - 원칙 3: admin은 소속 학교의 전체 실사 결과 조회 및 관리 가능
    // - 원칙 4: equipment 원본을 건드리지 않고 별도 독립 로그로 기록 보존
    // ============================================================================
    match /inspections/{inspectionId} {
      // 읽기: 교사는 본인이 작성한 실사 기록만 조회 가능, 관리자는 학교 전체 실사 기록 조회 가능
      allow read: if isSameSchool(resource.data.schoolId) && (
        (isTeacher() && resource.data.inspectorId == request.auth.uid) ||
        isAdmin()
      );

      // 생성: 소속 학교의 교사 또는 관리자가 본인 inspectorId로 실사 결과 등록
      allow create: if isSameSchool(request.resource.data.schoolId) &&
        request.resource.data.inspectorId == request.auth.uid &&
        (isTeacher() || isAdmin());

      // 수정/삭제: 현장 실사 로그의 수정 및 삭제는 관리자(admin) 권한으로만 가능
      allow update, delete: if isAdmin() && isSameSchool(resource.data.schoolId);
    }
  }
}
